PORT=5000
MONGO_URI=mongodb://localhost:27017/LostLink

# Frontend URL
CLIENT_URL=http://localhost:8080

# JWT
JWT_SECRET=change_me
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change_me_too
JWT_REFRESH_EXPIRE=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Số proxy đứng trước backend: để trống khi chạy local, đặt 1 trên Render
TRUST_PROXY=

# Email: có BREVO_API_KEY thì gửi qua Brevo API (dùng trên Render)
BREVO_API_KEY=
EMAIL_FROM=you@gmail.com

# Gmail SMTP (chỉ dùng khi chạy local)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_app_password

# Cloudinary 
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
